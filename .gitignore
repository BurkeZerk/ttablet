# Debian Live Build output
/cache/
/chroot/
/binary/
/source/
*.iso
*.img
*.log
*.md5
*.sha256
*.zsync

# Generated Live Build configuration
/config/binary
/config/bootstrap
/config/chroot
/config/common
/config/source
/config/debian-installer
/config/rootfs
/config/apt
/config/bootloaders
/config/bootloaders.*

# Generated artifacts and metadata
/.build/
/dist/
/binary.*
/chroot.*
/live-image-*
