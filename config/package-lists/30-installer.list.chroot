# Experimental TTablet 0.4 graphical installer (test in QEMU only)
calamares-settings-debian
# Calamares calls mkfs.fat to format the EFI System Partition.
dosfstools
# Calamares requires unsquashfs when the live filesystem is SquashFS.
squashfs-tools
# Debian's Calamares helper requests grub-efi by name in the target.
# Include the metapackage so APT does not need to fetch it offline.
grub-efi
grub-efi-amd64
efibootmgr
