# Intentional TTablet tablet essentials with --apt-recommends false.
# Keep touch-first settings, firmware updates, and connectivity.
# Debian Live's crucial user-setup/sudo are explicit in 10-tablet.list.chroot.
#
# Phosh's own hard dependencies remain installed via phosh-tablet.

# Touch-accessible settings and terminal that Phosh otherwise recommends
phosh-mobile-settings
gnome-console

# Bluetooth headphones and peripherals
bluez

# NetworkManager recommends these packages for Wi-Fi.
wpasupplicant
wireless-regdb

# Secure privilege dialogs and native firmware updates
polkitd
fwupd

# File browsing and removable drives
nautilus
udisks2

# Common graphical file dialogs and application portals
xdg-desktop-portal-gtk

# Retain tested Balanced/Power Saver controls even without recommends
power-profiles-daemon

# GDM fallback for environments without working Wayland
gnome-session-xsession
xserver-xorg

# Bazaar setup uses a graphical confirmation and Console for download progress.
flatpak
zenity
