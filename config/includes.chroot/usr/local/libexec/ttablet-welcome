#!/usr/bin/python3
"""Small offline-safe GTK welcome and shared, cancellable Flatpak setup."""
import fcntl
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import threading

BAZAAR = 'io.github.kolunmi.Bazaar'
CATALOG = Path('/usr/share/ttablet/optional-apps.json')
STATE = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'ttablet/optional-apps-complete'


def installed_scope(app):
    for scope in ('system', 'user'):
        if subprocess.run(['flatpak', 'info', '--' + scope, app],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            return scope
    return None


def first_run_allowed(cmdline, desktop, complete):
    return not complete and 'boot=live' not in cmdline.split() and 'Phosh' in desktop.split(':')


def load_catalog(path=CATALOG):
    data = json.loads(path.read_text())
    if data['version'] != 1:
        raise ValueError('Unsupported optional app catalog')
    apps = data['apps']
    ids = [a['id'] for a in apps]
    if len(ids) != len(set(ids)) or any(not x or x.startswith('-') or not all(c.isalnum() or c in '._-' for c in x) for x in ids):
        raise ValueError('Invalid optional app IDs')
    return apps


def install_selected(selected, cancelled, report, process_changed):
    """Install only explicit IDs, preserving completed work on retry/cancel."""
    for app in selected:
        if cancelled.is_set():
            return 130
        if installed_scope(app['id']):
            continue
        process = subprocess.Popen(['flatpak', 'install', '--system', '--app', '--assumeyes',
                                    'flathub', app['id']],
                                   stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                   text=True, start_new_session=True)
        process_changed(process)
        try:
            if cancelled.is_set():
                process.terminate()
            for line in process.stdout:
                report(line.strip()[-500:])
            code = process.wait()
        finally:
            process.stdout.close()
            process_changed(None)
        if code:
            return code
    return 130 if cancelled.is_set() else 0


def main():
    if '--first-run' in sys.argv and not first_run_allowed(
            Path('/proc/cmdline').read_text(), os.environ.get('XDG_CURRENT_DESKTOP', ''), STATE.exists()):
        return
    store = '--store' in sys.argv
    if store and (scope := installed_scope(BAZAAR)):
        os.execvp('flatpak', ['flatpak', 'run', '--' + scope, BAZAAR])
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, GLib

    class Welcome(Gtk.Window):
        def __init__(self):
            super().__init__(title='TTablet App Store' if store else 'TTablet Welcome')
            self.set_default_size(360, 560)
            self.set_border_width(12)
            self.process = None
            self.last_output = ""
            self.busy = False
            self.cancelled = threading.Event()
            self.lock = None
            self.connect('delete-event', self.close)
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            self.add(outer)
            scroll = Gtk.ScrolledWindow()
            scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            outer.pack_start(scroll, True, True, 0)
            body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            scroll.add(body)
            intro = ('Install Bazaar from Flathub when you are ready. Internet is needed only for setup.' if store else
                     'Your tablet is ready, including offline. Connect to Wi-Fi, open the App Store, or choose optional apps below. Nothing is selected automatically.\n\nFor touch typing, open the top quick settings and turn Docked off (Undocked). Use the keyboard control to show the on-screen keyboard.')
            label = Gtk.Label(label=intro, xalign=0)
            label.set_line_wrap(True)
            label.set_max_width_chars(38)
            body.pack_start(label, False, False, 0)
            self.actions = []
            if not store:
                for title, command in [('Wi-Fi Settings', ['gnome-control-center', 'wifi']),
                                       ('App Store', ['/usr/local/libexec/ttablet-app-store']),
                                       ('System Updates', ['gnome-software', '--mode=updates'])]:
                    button = Gtk.Button(label=title)
                    button.set_size_request(-1, 44)
                    button.connect('clicked', lambda _, cmd=command: subprocess.Popen(cmd))
                    body.pack_start(button, False, False, 0)
            self.options = []
            for app in ([] if store else load_catalog()):
                button = Gtk.CheckButton(label=app['label'] + '\n' + app['description'])
                button.set_size_request(-1, 52)
                body.pack_start(button, False, False, 0)
                self.options.append((button, app))
            self.status = Gtk.Label(xalign=0)
            self.status.set_line_wrap(True)
            self.status.set_max_width_chars(38)
            body.pack_start(self.status, False, False, 0)
            self.spinner = Gtk.Spinner()
            outer.pack_start(self.spinner, False, False, 0)
            self.install = Gtk.Button(label='Set up Bazaar' if store else 'Install selected apps')
            self.install.set_size_request(-1, 48)
            self.install.connect('clicked', self.start)
            outer.pack_start(self.install, False, False, 0)
            self.skip = Gtk.Button(label='Cancel' if store else 'Do this later')
            self.skip.set_size_request(-1, 48)
            self.skip.connect('clicked', self.close)
            outer.pack_start(self.skip, False, False, 0)
            self.refresh()

        def refresh(self):
            for button, app in self.options:
                present = installed_scope(app['id']) is not None
                button.set_sensitive(not present)
                if present:
                    button.set_active(False)
                    button.set_label(app['label'] + ' — installed')

        def close(self, *_):
            if self.busy:
                self.cancelled.set()
                if self.process and self.process.poll() is None:
                    try:
                        os.killpg(self.process.pid, signal.SIGTERM)
                    except ProcessLookupError:
                        pass
                self.status.set_text('Canceling… Apps already installed are kept. You can retry when setup stops.')
                return True
            if not store:
                try:
                    STATE.parent.mkdir(parents=True, exist_ok=True)
                    STATE.touch()
                except OSError as error:
                    self.status.set_text('Could not save your choice: ' + str(error))
                    return True
            Gtk.main_quit()
            return True

        def start(self, *_):
            selected = [{'id': BAZAAR, 'label': 'Bazaar'}] if store else [app for button, app in self.options if button.get_active() and button.get_sensitive()]
            if not selected:
                self.status.set_text('Choose an app, or select Do this later. No downloads have started.')
                return
            dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                       buttons=Gtk.ButtonsType.OK_CANCEL, text='Install ' + ', '.join(a['label'] for a in selected) + '?')
            dialog.format_secondary_text('Flatpak will calculate the download size during setup. Shared runtimes may require several hundred megabytes. Internet is required. Cancel stops setup; installed apps and existing data are kept.')
            answer = dialog.run()
            dialog.destroy()
            if answer != Gtk.ResponseType.OK:
                return
            self.lock = open(Path(os.environ['XDG_RUNTIME_DIR']) / 'ttablet-bazaar.lock', 'w')
            try:
                fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                self.lock.close()
                self.lock = None
                self.status.set_text('Another app setup is running. Finish or cancel it, then retry.')
                return
            self.busy = True
            self.last_output = ""
            self.cancelled.clear()
            self.install.set_sensitive(False)
            for button, _ in self.options:
                button.set_sensitive(False)
            self.skip.set_label('Cancel setup')
            self.spinner.start()
            self.status.set_text('Calculating and downloading apps and shared runtimes…')
            threading.Thread(target=self.worker, args=(selected,), daemon=True).start()

        def report(self, text):
            if text:
                self.last_output = text
                print(text, file=sys.stderr, flush=True)
                GLib.idle_add(self.status.set_text, text)

        def worker(self, selected):
            try:
                code = install_selected(selected, self.cancelled,
                                        self.report,
                                        lambda process: setattr(self, 'process', process))
            except OSError as error:
                code = 1
                self.report(str(error))
            GLib.idle_add(self.finished, code)

        def finished(self, code):
            self.busy = False
            self.lock.close()
            self.lock = None
            self.spinner.stop()
            self.install.set_sensitive(True)
            self.skip.set_label('Close' if store else 'Do this later')
            self.refresh()
            if code or self.cancelled.is_set():
                self.status.set_text('Setup did not finish. Installed apps are kept. Check Wi-Fi and retry using the setup button below, or close this window.\n\n' + self.last_output)
            else:
                self.status.set_text('Apps are ready in the app grid. You can close Welcome.')
                if store:
                    subprocess.Popen(['flatpak', 'run', '--' + (installed_scope(BAZAAR) or 'system'), BAZAAR])
                    Gtk.main_quit()

    window = Welcome()
    window.show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
