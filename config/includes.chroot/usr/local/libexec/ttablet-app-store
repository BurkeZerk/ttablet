#!/bin/sh
set -eu

app=io.github.kolunmi.Bazaar

if flatpak info --system "$app" >/dev/null 2>&1; then
    exec flatpak run --system "$app"
fi

if flatpak info --user "$app" >/dev/null 2>&1; then
    exec flatpak run --user "$app"
fi

if [ "${1:-}" != --install ]; then
    if zenity --question --title='TTablet App Store' \
        --text='Install Bazaar and its shared runtime from Flathub? A network connection is required.' \
        --ok-label=Install --cancel-label=Cancel --default-cancel; then
        exec kgx -e "$0 --install"
    fi
    exit 0
fi

# Serialize setup for this session to avoid parallel Flatpak transactions from
# repeated taps. The lock is released before Bazaar launches.
exec 9>"${XDG_RUNTIME_DIR:?}/ttablet-bazaar.lock"
if ! flock -n 9; then
    exit 0
fi

if flatpak info --system "$app" >/dev/null 2>&1 ||
    flatpak install --system --app --assumeyes flathub "$app"; then
    exec 9>&-
    exec flatpak run --system "$app"
fi

zenity --error --title='TTablet App Store' \
    --text='Bazaar setup did not finish. Check your connection and reopen TTablet App Store to retry.' || :
