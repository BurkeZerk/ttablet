# TTablet's original wallpaper; deliberately overridable by each user.
# Both modes use the same quiet dark background for a consistent Phosh feel.
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/ttablet/ttablet.svg'
picture-uri-dark='file:///usr/share/backgrounds/ttablet/ttablet.svg'
picture-options='zoom'
