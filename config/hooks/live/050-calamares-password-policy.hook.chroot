#!/bin/sh
set -eu

config=${1:-/etc/calamares/modules/users.conf}
test -f "$config"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT HUP INT TERM

# Calamares 3.3 treats every failed check as a warning when weak
# passwords are allowed, including the minimum length. Enforce only
# the native length check and omit libpwquality (and its dictionary).
# Replace Debian's top-level policy block and preserve other settings.
awk '
    /^passwordRequirements[[:blank:]]*:/ {
        if ($0 !~ /^passwordRequirements[[:blank:]]*:[[:blank:]]*(#.*)?$/)
            exit 1
        count++
        print "passwordRequirements:"
        print "  minLength: 4"
        print "allowWeakPasswords: false"
        print "allowWeakPasswordsDefault: false"
        skip = 1
        next
    }
    /^allowWeakPasswords(Default)?[[:blank:]]*:/ { next }
    skip && /^[[:blank:]]/ { next }
    /^[^#[:space:]]/ { skip = 0 }
    { print }
    END {
        if (count != 1)
            exit 1
    }
' "$config" > "$tmp" || {
    echo "Unexpected Calamares password policy layout in $config" >&2
    exit 1
}

cat "$tmp" > "$config"
